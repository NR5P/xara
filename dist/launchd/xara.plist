<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  per-user launchd agent for xara on macOS. replace YOU with your login name
  and check the xara path (cargo install puts it in ~/.cargo/bin). settings
  come from ~/.config/xara/xara.conf; logs go to ~/Library/Logs/xara.log.
  an agent (not a system daemon) is needed for microphone access.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.x0rro.xara</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOU/.cargo/bin/xara</string>
		<string>--config</string>
		<string>/Users/YOU/.config/xara/xara.conf</string>
		<string>--state-dir</string>
		<string>/Users/YOU/Library/Application Support/xara</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Library/Logs/xara.log</string>
</dict>
</plist>
